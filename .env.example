# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./voxiq.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/voxiq

# Application
DEBUG=true
PROJECT_NAME=VOXIQ

# Privacy & Retention
AUDIO_RETENTION_MINUTES=60
STORE_RAW_AUDIO=true

# LLM Providers (Optional for Layer 3 reasoning)
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
